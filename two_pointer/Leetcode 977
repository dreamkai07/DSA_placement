class Solution {
    public int[] sortedSquares(int[] nums) {

        int n = nums.length;
        int officer = 0;
        int cm = n-1;
        int result = n-1;

        
        int[] ans = new int[n];

        while (officer <= cm){
            if(Math.abs(nums[officer]) > Math.abs(nums[cm])){
                ans[result] = nums[officer] * nums[officer];
                officer++;

            }else {
                ans[result] = nums[cm] * nums[cm];
                cm--;
            }
            result--;

        }
        return ans;

    }
}

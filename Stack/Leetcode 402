class Solution {
    public String removeKdigits(String num, int k) {
        int n = num.length();

        // Stack implemented using char array
        char[] stack = new char[n];
        int top = 0;

        for (int i = 0; i < n; i++) {
            char current = num.charAt(i);

            // Remove larger digits from the left
            while (k > 0 && top > 0 && stack[top - 1] > current) {
                top--;
                k--;
            }

            stack[top++] = current;
        }

        // If k is still remaining, remove digits from the end
        top -= k;

        // Skip leading zeros
        int start = 0;
        while (start < top && stack[start] == '0') {
            start++;
        }

        // If nothing remains
        if (start == top) {
            return "0";
        }

        return new String(stack, start, top - start);
    }
}

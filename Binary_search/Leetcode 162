class Solution {
    public int findPeakElement(int[] nums) {
        int left = 0;
        int right = nums.length - 1;

        while (left < right) {
            int mid = left + (right - left) / 2;

            // पर्वत ऊपर जा रहा है
            if (nums[mid] < nums[mid + 1]) {
                left = mid + 1;
            } 
            // पर्वत नीचे जा रहा है
            else {
                right = mid;
            }
        }

        return left;
    }
}

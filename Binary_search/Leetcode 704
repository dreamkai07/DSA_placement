class Solution {
    public int search(int[] nums, int target) {

        int left = 0;
        int right = nums.length - 1;

        while (left <= right) {

            int mid = left + (right - left) / 2;

            if (nums[mid] == target) {
                return mid;
            }

            // Target is in the right half
            if (nums[mid] < target) {
                left = mid + 1;
            }

            // Target is in the left half
            else {
                right = mid - 1;
            }
        }

        return -1;
    }
}

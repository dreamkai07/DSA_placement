class Solution {

    public boolean circularArrayLoop(int[] nums) {
        int n = nums.length;

        for (int i = 0; i < n; i++) {

            if (nums[i] == 0) {
                continue;
            }

            boolean direction = nums[i] > 0;

            int slow = i;
            int fast = i;

            while (true) {

                // Slow moves one step
                int nextSlow = nextIndex(nums, slow);

                // Direction changed or single-element loop
                if (nums[nextSlow] == 0 ||
                    (nums[nextSlow] > 0) != direction ||
                    nextSlow == slow) {
                    break;
                }

                // Fast moves first step
                int nextFast = nextIndex(nums, fast);

                if (nums[nextFast] == 0 ||
                    (nums[nextFast] > 0) != direction ||
                    nextFast == fast) {
                    break;
                }

                // Fast moves second step
                int nextFast2 = nextIndex(nums, nextFast);

                if (nums[nextFast2] == 0 ||
                    (nums[nextFast2] > 0) != direction ||
                    nextFast2 == nextFast) {
                    break;
                }

                slow = nextSlow;
                fast = nextFast2;

                // Cycle found
                if (slow == fast) {
                    return true;
                }
            }

            // Mark this entire path as visited
            int current = i;

            while (nums[current] != 0 &&
                   (nums[current] > 0) == direction) {

                int next = nextIndex(nums, current);
                nums[current] = 0;
                current = next;
            }
        }

        return false;
    }

    private int nextIndex(int[] nums, int index) {
        int n = nums.length;

        return ((index + nums[index]) % n + n) % n;
    }
}

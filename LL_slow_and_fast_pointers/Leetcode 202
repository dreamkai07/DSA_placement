class Solution {

    public int func(int n) {
        int sum = 0;

        while (n > 0) {
            int d = n % 10;
            n = n / 10;
            sum = sum + (d * d);
        }

        return sum;
    }

    public boolean isHappy(int n) {

        int slow = n;
        int fast = n;

        // Phase 1: Find the meeting point
        slow = func(slow);
        fast = func(func(fast));

        while (slow != fast) {
            slow = func(slow);
            fast = func(func(fast));
        }

        // If cycle ends at 1, it is a happy number
        return slow == 1;
    }
}
